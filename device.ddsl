            },
            /// CHGLED pin display function config. LED is active-low (on when CHGLED is low).
            field chgled_func 2:1 -> _ as enum ChgledFunction {
                /// Type A: off=idle/full, blink1Hz=alarm, blink4Hz=overvoltage, on=charging
                TypeA: 0,
                /// Type B: off=battery only, blink1Hz=charging, blink4Hz=alarm, on=VBUS no-bat/full
                TypeB: 1,
                /// Manual control via chgled_out_ctrl
                Manual: 2,
                /// Reserved
                Reserved: 3,
            },
            /// CHGLED pin enable (true: enable, false: disable).
            field chgled_en 0,
        },
    },
    /// Button battery charge termination voltage setting.
    register ButtonBatteryCharge {
        address: 0x6A,
        fields: fieldset _ {
            size-bytes: 1,

            /// Button Battery charge termination voltage (2.6V + N*0.1V).
            field btn_chg_cfg 2:0 -> _ as enum ButtonBatteryChargeVoltage {
                /// 2.6V
                V2_6: 0,
                /// 2.7V
                V2_7: 1,
                /// 2.8V
                V2_8: 2,
                /// 2.9V
                V2_9: 3,
                /// 3.0V
                V3_0: 4,
                /// 3.1V
                V3_1: 5,
                /// 3.2V
                V3_2: 6,
                /// 3.3V
                V3_3: 7,
            },
        },
    },
}
