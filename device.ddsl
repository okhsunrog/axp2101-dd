/// AXP2101 Single Cell PMIC with E-gauge Device Driver Definition
/// This file defines the register map and configuration for the AXP2101
/// Power Management IC manufactured by X-Powers.
///
/// Features:
/// - 3.9V-5.5V Input Operating Range
/// - Single Cell Battery with Fuel Gauge (E-gauge 3.0)
/// - 4 DC-DC converters (DCDC1-4)
/// - 11 LDO regulators (ALDO1-4, BLDO1-2, DLDO1-2, CPUSLDO, RTCLDO1-2)
/// - 100mA-1A Linear charger
/// - 14-bit ADC for voltage/temperature monitoring
/// - I2C/TWI and RSB interface support
///
/// Interface: I2C (default address 0x68/0x69) or RSB
/// Package: QFN-40 (5mm x 5mm)
device AxpLowLevel {
    default-byte-order: BE,
    register-address-type: u8,
    // Split on underscores, hyphens, lower->upper and every letter<->digit
    // transition so `Dcdc1VoltageConfig` becomes `dcdc_1_voltage_config`.
    word-boundaries: "_:-: :bB:A1:1A:1a:a1:AAa",
    default-access: RW,

    /// Power management status register indicating various system states including
    /// VBUS status, BATFET state, battery presence, and thermal regulation.
    register PowerStatus {
        address: 0x00,
        access: RO,
        fields: fieldset _ {
            size-bytes: 1,

            /// VBUS good indication (true: good, false: not good).
            field vbus_good 5,
            /// BATFET state (true: open, false: closed).
            field batfet_state 4,
            /// Battery present state (true: present, false: absent).
            field battery_present 3,
            /// Battery in Active Mode (true: active mode, false: normal).
            field battery_active_mode 2,
            /// Thermal regulation status (true: in thermal regulation, false: normal).
            field thermal_regulation_active 1,
            /// Current limit state (true: in current limit, false: normal).
            field current_limit_active 0,
        },
    },
    /// System status register showing battery current direction, system power state,
    /// VINDPM status, and charging status.
    register SystemStatus {
        address: 0x01,
        access: RO,
        fields: fieldset _ {
            size-bytes: 1,

            /// Battery current direction indicator.
            field battery_current_direction 6:5 -> _ as enum BatteryCurrentDirection {
                /// Battery in standby
                Standby: 0,
                /// Battery charging
                Charging: 1,
                /// Battery discharging
                Discharging: 2,
                /// Reserved state
                Reserved: 3,
            },
            /// System status indication (true: system power on, false: system power off).
            field system_power_on 4,
            /// VINDPM status (true: in VINDPM, false: not in VINDPM).
            field vindpm_active 3,
            /// Charging status indication.
            field charging_status 2:0 -> _ as enum ChargingStatus {
                /// Trickle charge mode
                TriCharge: 0,
                /// Pre-charge mode
                PreCharge: 1,
                /// Constant current (CC) mode
                ConstantCurrent: 2,
                /// Constant voltage (CV) mode
                ConstantVoltage: 3,
                /// Charge completed
                ChargeDone: 4,
                /// Not charging
                NotCharging: 5,
                /// Reserved state
                Reserved: default _,
            },
        },
    },
    /// Chip identification register containing version and ID information.
    /// Expected value for AXP2101 is 0x47 (0100_0111).
    register ChipId {
        address: 0x03,
        access: RO,
        fields: fieldset _ {
            size-bytes: 1,

            /// Chip ID high bits.
            field chip_id_high 7:6,
            /// Chip version.
            field chip_version 5:4 -> _ as enum ChipVersion {
                /// A version
                VersionA: 0,
                /// B version
                VersionB: 1,
                /// Reserved
                Reserved1: 2,
                /// Reserved
                Reserved2: 3,
            },
            /// Chip ID low bits. Combined with high bits: 01_0111 = AXP2101.
            field chip_id_low 3:0,
        },
    },
    /// General purpose data buffer registers for storing system data.
    /// These registers retain their values as long as any power source is present.
    /// Useful for storing configuration data or system state between resets.
    register DataBuffer[5 stride 1] {
        address: 0x04,
        reset: 0x0,
        fields: fieldset _ {
            size-bytes: 1,

            /// 8-bit data storage value.
            field data 7:0,
        },
    },
    /// Common configuration register controlling various system behaviors including
    /// discharge control, restart functionality, and power-off controls.
    register CommonConfig {
        address: 0x10,
        reset: 0x30,
        fields: fieldset _ {
            size-bytes: 1,

            /// Internal off-discharge enable for DCDC & LDO & SWITCH (true: enable, false: disable).
            field discharge_off_enable 5,
            /// PWROK PIN pull low to restart the system (true: enable, false: disable).
            field pwrok_restart_enable 3,
            /// PWRON 16s to shutdown the PMIC enable (true: enable, false: disable).
            field power_on_shutdown_enable 2,
            /// Restart the SoC System, POWOFF/POWON and reset related registers (true: reset).
            field soft_system_restart 1 WO,
            /// Soft PWROFF (true: power off).
            field soft_power_off 0 WO,
        },
    },
    /// BATFET control register for battery connection management and overcurrent protection.
    register BatfetControl {
        address: 0x12,
        fields: fieldset _ {
            size-bytes: 1,

            /// BATFET enable when POWEROFF and Battery only (true: enable, false: disable).
            field batfet_poweroff_enable 3,
            /// BATFET close when OCP (6A) for 100us (true: enable, false: disable).
            field batfet_ocp_enable 1,
        },
    },
    /// Die temperature control register for setting over-temperature protection
    /// and enabling temperature detection.
    register DieTempControl {
        address: 0x13,
        reset: 0x3,
        fields: fieldset _ {
            size-bytes: 1,

            /// DIE Over Temperature Protection Level1 Config.
            field die_over_temp_protection_threshold 2:1 -> _ as enum DieOverTempThreshold {
                /// 115°C
                Deg115: 0,
                /// 125°C
                Deg125: 1,
                /// 135°C
                Deg135: 2,
                /// Reserved
                Reserved: 3,
            },
            /// DIE Temperature Detect Enable (true: enable, false: disable).
            field die_temp_detect_enable 0,
        },
    },
    /// Minimum system voltage control.
    register MinSystemVoltageControl {
        address: 0x14,
        reset: 0x60,
        fields: fieldset _ {
            size-bytes: 1,

            /// Linear Charger Vsys voltage dpm. 4.1V + N*0.1V
            field in_vsys_dpm 6:4 -> _ as enum MinSystemVoltage {
                /// 4.1V
                V4_1: 0,
                /// 4.2V
                V4_2: 1,
                /// 4.3V
                V4_3: 2,
                /// 4.4V
                V4_4: 3,
                /// 4.5V
                V4_5: 4,
                /// 4.6V
                V4_6: 5,
                /// 4.7V
                V4_7: 6,
                /// 4.8V
                V4_8: 7,
            },
        },
    },
    /// VINDPM (Input Voltage Dynamic Power Management) configuration register.
    /// Controls the minimum input voltage threshold for power management.
    register VindpmConfig {
        address: 0x15,
        reset: 0x6,
        fields: fieldset _ {
            size-bytes: 1,

            /// VINDPM threshold configuration.
            field vindpm_threshold 3:0 -> _ as enum VindpmVoltage {
                /// 3.88V
                V3_88: 0,
                /// 3.96V
                V3_96: 1,
                /// 4.04V
                V4_04: 2,
                /// 4.12V
                V4_12: 3,
                /// 4.20V
                V4_20: 4,
                /// 4.28V
                V4_28: 5,
                /// 4.36V
                V4_36: 6,
                /// 4.44V
                V4_44: 7,
                /// 4.52V
                V4_52: 8,
                /// 4.60V
                V4_60: 9,
                /// 4.68V
                V4_68: 10,
                /// 4.76V
                V4_76: 11,
                /// 4.84V
                V4_84: 12,
                /// 4.92V
                V4_92: 13,
                /// 5.00V
                V5_00: 14,
                /// 5.08V
                V5_08: 15,
            },
        },
    },
    /// Input current limit configuration register.
    /// Sets the maximum allowable input current from VBUS.
    register InputCurrentLimit {
        address: 0x16,
        reset: 0x1,
        fields: fieldset InputCurrentLimitFieldSet {
            size-bytes: 1,

            /// Input current limit setting.
            field current_limit 2:0 -> _ as enum InputCurrentLimit {
                /// 100mA
                Ma100: 0,
                /// 500mA
                Ma500: 1,
                /// 900mA
                Ma900: 2,
                /// 1000mA
                Ma1000: 3,
                /// 1500mA
                Ma1500: 4,
                /// 2000mA
                Ma2000: 5,
                /// Reserved
                Reserved1: 6,
                /// Reserved
                Reserved2: 7,
            },
        },
    },
    /// Indicates the source of the power-on event.
    register PowerOnStatus {
        address: 0x20,
        access: RO,
        fields: fieldset _ {
            size-bytes: 1,

            /// POWERON always high when EN Mode as POWERON Source (true: yes, false: no).
            field en_pwron_stat 5,
            /// Battery Insert and Good as POWERON Source (true: yes, false: no).
            field bat_pwron_stat 4,
            /// Battery Voltage > 3.3V when Charged as POWERON Source (true: yes, false: no).
            field chg_pwron_stat 3,
            /// Vbus Insert and Good as POWERON Source (true: yes, false: no).
            field vbus_pwron_stat 2,
            /// IRQ PIN Pull-down as POWERON Source (true: yes, false: no).
            field irq_pwron_stat 1,
            /// POWERON low for onlevel when POWERON Mode as POWERON Source (true: yes, false: no).
            field btn_pwron_stat 0,
        },
    },
    /// Indicates the source of the power-off event.
    register PowerOffStatus {
        address: 0x21,
        access: RO,
        fields: fieldset _ {
            size-bytes: 1,

            /// Die Over Temperature as POWEROFF Source (true: yes, false: no).
            field dot_pwroff_stat 7,
            /// DCDC Over Voltage as POWEROFF Source (true: yes, false: no).
            field dcov_pwroff_stat 6,
            /// DCDC Under Voltage as POWEROFF Source (true: yes, false: no).
            field dcuv_pwroff_stat 5,
            /// VBUS Over Voltage as POWEROFF Source (true: yes, false: no).
            field vbov_pwroff_stat 4,
            /// Vsys Under Voltage as POWEROFF Source (true: yes, false: no).
            field vsuv_pwroff_stat 3,
            /// POWERON always low when EN Mode as POWEROFF Source (true: yes, false: no).
            field en_pwroff_stat 2,
            /// Software config as POWEROFF Source (true: yes, false: no).
            field sw_pwroff_stat 1,
            /// POWERON Pull down for offlevel when POWERON Mode as POWEROFF Source (true: yes, false: no).
            field btn_pwroff_stat 0,
        },
    },
    /// Enables different sources for power-off events.
    register PowerOffEnable {
        address: 0x22,
        fields: fieldset _ {
            size-bytes: 1,

            /// DIE Over-Temperature (LEVEL2) as POWEROFF Source enable (true: enable, false: disable).
            field dot_pwroff_en 2,
            /// PWRON > OFFLEVEL as POWEROFF Source enable (true: enable, false: disable).
            field btn_pwroff_en 1,
            /// Function Select when btn_pwroff_en=1 and button power-off occur (0: Power-off, 1: Restart).
            field btn_pwroff_mode 0,
        },
    },
    /// Controls DCDC OVP/UVP power-off enables.
    register DcdcPowerOffControl {
        address: 0x23,
        fields: fieldset _ {
            size-bytes: 1,

            /// DCDC 120%(130%) high voltage turn off PMIC function (true: enable, false: disable).
            field dcdc_ovp_en 5,
            /// DCDC5 85% low voltage turn off PMIC function (true: enable, false: disable).
            field dcdc5_uvp_en 4,
            /// DCDC4 85% low voltage turn off PMIC function (true: enable, false: disable).
            field dcdc4_uvp_en 3,
            /// DCDC3 85% low voltage turn off PMIC function (true: enable, false: disable).
            field dcdc3_uvp_en 2,
            /// DCDC2 85% low voltage turn off PMIC function (true: enable, false: disable).
            field dcdc2_uvp_en 1,
            /// DCDC1 85% low voltage turn off PMIC function (true: enable, false: disable).
            field dcdc1_uvp_en 0,
        },
    },
    /// Vsys voltage for POWEROFF threshold setting.
    register VoffThreshold {
        address: 0x24,
        fields: fieldset _ {
            size-bytes: 1,

            /// Battery Voltage for POWEROFF (2.6V + N*0.1V).
            field voff_thld 2:0 -> _ as enum VoffVoltage {
                /// 2.6V
                V2_6: 0,
                /// 2.7V
                V2_7: 1,
                /// 2.8V
                V2_8: 2,
                /// 2.9V
                V2_9: 3,
                /// 3.0V
                V3_0: 4,
                /// 3.1V
                V3_1: 5,
                /// 3.2V
                V3_2: 6,
                /// 3.3V
                V3_3: 7,
            },
        },
    },
    /// PWROK setting and PWROFF sequence control.
    register PowerTimingControl {
        address: 0x25,
        fields: fieldset _ {
            size-bytes: 1,

            /// Check the PWROK Pin enable after all dcdc/ldo output valid 128ms (true: enable, false: disable).
            field pwrok_chk_en 4,
            /// POWEROFF Delay 4ms after PWROK disable (true: enable, false: disable).
            field pwroff_dly_en 3,
            /// POWEROFF Sequence Control (0: At the same time, 1: the reverse of the Startup).
            field pwroff_seq_ctrl 2,
            /// Delay of PWROK after all power output good.
            field pwrok_dly 1:0 -> _ as enum PwrokDelay {
                /// 8ms
                Ms8: 0,
                /// 16ms
                Ms16: 1,
                /// 32ms
                Ms32: 2,
                /// 64ms
                Ms64: 3,
            },
        },
    },
    /// Sleep and wakeup control.
    register SleepWakeupControl {
        address: 0x26,
        fields: fieldset _ {
            size-bytes: 1,

            /// IRQ Pin low to Wakeup (true: enable, false: disable).
            field irq_wakeup_en 4,
            /// PWROK be low-level enable when Wakup (true: enable, false: disable).
            field pwrok_wakeup_ind 3,
            /// DCDC/LDO Voltage Select when Wakup (0: The Default, 1: The voltage before wakup).
            field wakeup_cfg_sel 2,
            /// Wake Up enable (true: enable, false: disable).
            field wakeup_en 1,
            /// SLEEP enable (true: enable, false: disable).
            field sleep_en 0,
        },
    },
    /// IRQLEVEL/OFFLEVEL/ONLEVEL setting.
    register PowerOnLevel {
        address: 0x27,
        fields: fieldset _ {
            size-bytes: 1,

            /// IRQLEVEL config.
            field irq_level 5:4 -> _ as enum IrqLevel {
                /// 1s
                S1: 0,
                /// 1.5s
                S1_5: 1,
                /// 2s
                S2: 2,
                /// 2.5s
                S2_5: 3,
            },
            /// OFFLEVEL config.
            field off_level 3:2 -> _ as enum OffLevel {
                /// 4s
                S4: 0,
                /// 6s
                S6: 1,
                /// 8s
                S8: 2,
                /// 10s
                S10: 3,
            },
            /// ONLEVEL config.
            field on_level 1:0 -> _ as enum OnLevel {
                /// 128ms
                Ms128: 0,
                /// 512ms
                Ms512: 1,
                /// 1s
                S1: 2,
                /// 2s
                S2: 3,
            },
        },
    },
    /// Fast power-on setting for DCDCs.
    register FastPowerOnConfig0 {
        address: 0x28,
        fields: fieldset _ {
            size-bytes: 1,

            /// DCDC4 Fast Power On Start Sequence (00-10: Start Sequence Code, 11: disable).
            field dcdc4_fstart_seq 7:6,
            /// DCDC3 Fast Power On Start Sequence (00-10: Start Sequence Code, 11: disable).
            field dcdc3_fstart_seq 5:4,
            /// DCDC2 Fast Power On Start Sequence (00-10: Start Sequence Code, 11: disable).
            field dcdc2_fstart_seq 3:2,
            /// DCDC1 Fast Power On Start Sequence (00-10: Start Sequence Code, 11: disable).
            field dcdc1_fstart_seq 1:0,
        },
    },
    /// Fast power-on setting for ALDOs.
    register FastPowerOnConfig1 {
        address: 0x29,
        fields: fieldset _ {
            size-bytes: 1,

            /// ALDO3 Fast Power On Start Sequence (00-10: Start Sequence Code, 11: disable).
            field aldo3_fstart_seq 7:6,
            /// ALDO2 Fast Power On Start Sequence (00-10: Start Sequence Code, 11: disable).
            field aldo2_fstart_seq 5:4,
            /// ALDO1 Fast Power On Start Sequence (00-10: Start Sequence Code, 11: disable).
            field aldo1_fstart_seq 3:2,
            /// DCDC5 Fast Power On Start Sequence (00-10: Start Sequence Code, 11: disable).
            field dcdc5_fstart_seq 1:0,
        },
    },
    /// Fast power-on setting for CPUSLDO, BLDOs, and ALDO4.
    register FastPowerOnConfig2 {
        address: 0x2A,
        fields: fieldset _ {
            size-bytes: 1,

            /// CPUSLDO Fast Power On Start Sequence (00-10: Start Sequence Code, 11: disable).
            field cpusldo_fstart_seq 7:6,
            /// BLDO2 Fast Power On Start Sequence (00-10: Start Sequence Code, 11: disable).
            field bldo2_fstart_seq 5:4,
            /// BLDO1 Fast Power On Start Sequence (00-10: Start Sequence Code, 11: disable).
            field bldo1_fstart_seq 3:2,
            /// ALDO4 Fast Power On Start Sequence (00-10: Start Sequence Code, 11: disable).
            field aldo4_fstart_seq 1:0,
        },
    },
    /// Fast power-on setting and control for DLDOs.
    register FastPowerOnConfig3 {
        address: 0x2B,
        fields: fieldset _ {
            size-bytes: 1,

            /// Fast Power On Enable (true: enable, false: disable).
            field fast_pwron_en 7,
            /// Fast Wake up Enable (true: enable, false: disable).
            field fast_wakeup_en 6,
            /// DLDO2 Fast Power On Start Sequence (00-10: Start Sequence Code, 11: disable).
            field dldo2_fstart_seq 3:2,
            /// DLDO1 Fast Power On Start Sequence (00-10: Start Sequence Code, 11: disable).
            field dldo1_fstart_seq 1:0,
        },
    },
    /// ADC Channel enable control.
    register AdcChannelEnable0 {
        address: 0x30,
        fields: fieldset _ {
            size-bytes: 1,

            /// general purpose ADC channel enable (true: enable, false: disable).
            field gpadc_ch_en 5,
            /// die temperature measure ADC channel enable (true: enable, false: disable).
            field tdie_ch_en 4,
            /// system voltage measure ADC channel enable (true: enable, false: disable).
            field vsys_ch_en 3,
            /// vbus voltage measure ADC channel enable (true: enable, false: disable).
            field vbus_ch_en 2,
            /// TS pin measure ADC channel enable (true: enable, false: disable).
            field ts_ch_en 1,
            /// battery voltage measure ADC channel enable (true: enable, false: disable).
            field vbat_ch_en 0,
        },
    },
    /// Battery parameter ROM.
    register BatteryParameter {
        address: 0xA1,
        fields: fieldset _ {
            size-bytes: 1,

            field brom 7:0,
        },
    },
    /// Fuel gauge control.
    register FuelGaugeControl {
        address: 0xA2,
        fields: fieldset _ {
            size-bytes: 1,

            /// ROM or SRAM select (1: select sram, 0: select rom).
            field rom_sel 4,
            /// brom writer control (1: enable, 0: disable).
            field bromup_en 0,
        },
    },
    /// Module enable register controlling major system functions including
    /// fuel gauge, battery charging, and watchdog functionality.
    register ModuleEnable {
        address: 0x18,
        reset: 0xa,
        fields: fieldset _ {
            size-bytes: 1,

            /// Fuel Gauge module enable (true: enable, false: disable).
            field fuel_gauge_enable 3,
            /// Button battery charge enable (true: enable, false: disable).
            field button_battery_charge_enable 2,
            /// Cell battery charge enable (true: enable, false: disable).
            field battery_charge_enable 1,
            /// Watchdog module enable (true: enable, false: disable).
            field watchdog_enable 0,
        },
    },
    /// Watchdog timer control.
    register WatchdogControl {
        address: 0x19,
        reset: 0x6,
        fields: fieldset _ {
            size-bytes: 1,

            /// Watchdog Reset Config.
            field watchdog_reset_config 5:4 -> _ as enum WatchdogResetConfig {
                /// IRQ only
                IrqOnly: 0,
                /// IRQ and System Reset
                IrqAndSystemReset: 1,
                /// IRQ, System Reset and Pull down PWROK 1s
                IrqResetAndPwrokLow: 2,
                /// IRQ, System Reset, DCDC/LDO PWROFF & PWRON
                IrqResetAndPowerCycle: 3,
            },
            /// Watchdog clear signal (true: clear).
            field watchdog_clear 3 WO,
            /// TWSI watchdog timer config.
            field watchdog_timer 2:0 -> _ as enum WatchdogTimer {
                /// 1s
                S1: 0,
                /// 2s
                S2: 1,
                /// 4s
                S4: 2,
                /// 8s
                S8: 3,
                /// 16s
                S16: 4,
                /// 32s
                S32: 5,
                /// 64s
                S64: 6,
                /// 128s
                S128: 7,
            },
        },
    },
    /// Low battery warning threshold setting.
    register LowBatteryWarningThreshold {
        address: 0x1A,
        reset: 0xa1,
        fields: fieldset _ {
            size-bytes: 1,

            /// Low battery warning threshold 5-20%, 1% per step. (value + 5)%
            field warning_threshold 7:4,
            /// Low battery shutdown threshold 0-15%, 1% per step.
            field shutdown_threshold 3:0,
        },
    },
    /// Recharge configuration register controlling automatic recharge behavior
    /// based on battery voltage or fuel gauge SOC level.
    register RechargeConfig {
        address: 0x60,
        reset: 0x02,
        fields: fieldset _ {
            size-bytes: 1,

            /// Recharge with Battery Voltage below Vrechg enable (true: enable, false: disable).
            field voltage_recharge_enable 1,
            /// Recharge with Egauge SOC Level enable (true: enable, false: disable).
            field gauge_recharge_enable 0,
        },
    },
    /// Pre-charge current limit configuration.
    /// Controls the charging current during the pre-charge phase when battery voltage is low.
    register PrechargeCurrentConfig {
        address: 0x61,
        reset: 0x5,
        fields: fieldset _ {
            size-bytes: 1,

            /// Pre-charge current limit (25mA per step).
            field precharge_current 3:0 -> _ as enum PrechargeCurrentLimit {
                /// 0mA
                Ma0: 0,
                /// 25mA
                Ma25: 1,
                /// 50mA
                Ma50: 2,
                /// 75mA
                Ma75: 3,
                /// 100mA
                Ma100: 4,
                /// 125mA
                Ma125: 5,
                /// 150mA
                Ma150: 6,
                /// 175mA
                Ma175: 7,
                /// 200mA
                Ma200: 8,
                /// Reserved values 9-15
                Reserved: default _,
            },
        },
    },
    /// Fast charge (constant current) current limit configuration.
    /// Controls the charging current during the main charging phase.
    register FastChargeCurrentConfig {
        address: 0x62,
        fields: fieldset _ {
            size-bytes: 1,

            /// Fast charge current limit.
            field fast_charge_current 4:0 -> _ as enum FastChargeCurrentLimit {
                /// 0mA
                Ma0: 0,
                /// 100mA
                Ma100: 4,
                /// 125mA
                Ma125: 5,
                /// 150mA
                Ma150: 6,
                /// 175mA
                Ma175: 7,
                /// 200mA
                Ma200: 8,
                /// 300mA
                Ma300: 9,
                /// 400mA
                Ma400: 10,
                /// 500mA
                Ma500: 11,
                /// 600mA
                Ma600: 12,
                /// 700mA
                Ma700: 13,
                /// 800mA
                Ma800: 14,
                /// 900mA
                Ma900: 15,
                /// 1000mA
                Ma1000: 16,
                /// Reserved values
                Reserved: default _,
            },
        },
    },
    /// Charge termination current configuration.
    /// Controls when charging stops based on current level.
    register TerminationCurrentConfig {
        address: 0x63,
        reset: 0x15,
        fields: fieldset _ {
            size-bytes: 1,

            /// Charging termination current enable (true: enable, false: disable).
            field termination_enable 4,
            /// Termination current limit (25mA per step).
            field termination_current 3:0 -> _ as enum TerminationCurrentLimit {
                /// 0mA
                Ma0: 0,
                /// 25mA
                Ma25: 1,
                /// 50mA
                Ma50: 2,
                /// 75mA
                Ma75: 3,
                /// 100mA
                Ma100: 4,
                /// 125mA
                Ma125: 5,
                /// 150mA
                Ma150: 6,
                /// 175mA
                Ma175: 7,
                /// 200mA
                Ma200: 8,
                /// Reserved values 9-15
                Reserved: default _,
            },
        },
    },
    /// Charge voltage limit configuration.
    /// Sets the target voltage for battery charging.
    register ChargeVoltageConfig {
        address: 0x64,
        reset: 0x3,
        fields: fieldset _ {
            size-bytes: 1,

